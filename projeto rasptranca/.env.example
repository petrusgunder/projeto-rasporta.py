# ==============================================================================
# CONFIGURACAO DE PRODUCAO - RASPORTA (DOCKER + RASPBERRY PI)
# Copie este arquivo para .env e preencha com valores secretos fortes:
#   cp .env.example .env && chmod 600 .env
# ==============================================================================

# Chave secreta criptografica do Flask (gere com: python3 -c "import secrets; print(secrets.token_hex(32))")
RASPORTA_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES_HEXADECIMAIS

# Ative "1" quando o sistema estiver atras de HTTPS (Caddy/DuckDNS ou Cloudflare Tunnel)
RASPORTA_HTTPS=1

# Credenciais do primeiro Administrador Principal (criado apenas no primeiro boot se nao existir)
RASPORTA_ADMIN_NOME=Administrador Principal
RASPORTA_ADMIN_EMAIL=admin@ifsc.edu.br
RASPORTA_ADMIN_SENHA=TroqueEstaSenhaPorUmaForte@2026

# Opcional: Provisionamento automatico da primeira estacao fisica no boot
# RASPORTA_STATION_ID=estacao-lab-info-1
# RASPORTA_STATION_SECRET=SUBSTITUA_POR_CHAVE_HMAC_64_HEX
# RASPORTA_STATION_LAB_ID=1

# Dominio publico (usado pelo Caddy caso utilize DuckDNS + HTTPS automatico)
RASPORTA_DOMINIO=seu-subdominio.duckdns.org